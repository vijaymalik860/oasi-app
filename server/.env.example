# ============================================================
# OASI Backend — server/.env EXAMPLE (Template)
# ============================================================
# Isko copy karke server/.env banao aur apni values fill karo
# cp server/.env.example server/.env
# ============================================================

# ── Database ───────────────────────────────────────────────
# Cloud (Neon/Supabase):
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require

# Local PostgreSQL (comment out DATABASE_URL and use these):
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=oasi_db
# DB_USER=oasi_user
# DB_PASSWORD=YourPasswordHere

# ── Server ─────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── JWT ────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET
JWT_EXPIRES_IN=8h

# ── CORS ───────────────────────────────────────────────────
# Production mein apna frontend domain set karo
ALLOWED_ORIGIN=http://localhost:5173
