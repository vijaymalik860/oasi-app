# ============================================================
# OASI Portal — Root Environment Configuration
# ============================================================
# DEPLOYMENT GUIDE:
#   Development : Sab values as-is rakhein
#   Production  : VITE_API_URL set karo (e.g. https://api.oasi.haryana.gov.in)
#                 FRONTEND_PORT aur BACKEND_PORT apne server ke hisaab se set karo
# ============================================================

# ── Ports ──────────────────────────────────────────────────
# Frontend (Vite dev server) ka port
FRONTEND_PORT=5173

# Backend (Express server) ka port — server/.env ke PORT se match karna chahiye
BACKEND_PORT=5000

# ── API URL ────────────────────────────────────────────────
# Development: Empty rakhein — Vite proxy /api/* → localhost:BACKEND_PORT
# Production : Poora backend URL set karo
#   Example  : VITE_API_URL=https://api.oasi.haryana.gov.in
VITE_API_URL=
