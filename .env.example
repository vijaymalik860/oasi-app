# ============================================================
# OASI Portal — Root .env EXAMPLE (Template)
# ============================================================
# Isko copy karke .env banao aur apni values fill karo
# cp .env.example .env
# ============================================================

# Frontend port (Vite dev server)
FRONTEND_PORT=5173

# Backend port — server/.env ke PORT se match karna chahiye
BACKEND_PORT=5000

# API URL:
#   Development = empty (Vite proxy use karega)
#   Production  = full backend URL
VITE_API_URL=
